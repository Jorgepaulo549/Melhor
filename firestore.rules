rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default safety deny net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { 
      return request.resource.data; 
    }
    function existing() { 
      return resource.data; 
    }
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // UserProfile Validation Rules
    function isValidUserProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.phone is string && data.phone.size() <= 30
          && data.nif is string && data.nif.size() <= 50
          && data.balance is number && data.balance >= 0
          && data.completedCount is number && data.completedCount >= 0
          && data.qualityScore is number && data.qualityScore >= 0 && data.qualityScore <= 100
          && data.isVerified is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && (
        // Allow updating specific keys
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'phone', 'nif', 'isVerified', 'balance', 'completedCount', 'qualityScore'])
      );
      
      // Transactions Sub-collection Rules
      match /transactions/{transactionId} {
        function isValidTransaction(data) {
          return data.id is string && data.id.size() <= 100
              && data.amount is number && data.amount > 0
              && data.method is string && data.method.size() <= 50
              && data.target is string && data.target.size() <= 100
              && data.date is string && data.date.size() <= 50
              && data.status is string && data.status.size() <= 50;
        }
        
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      }
      
      // Fraud Audit Event Logs Sub-collection Rules
      match /fraudLogs/{logId} {
        function isValidFraudLog(data) {
          return data.id is string && data.id.size() <= 100
              && data.timestamp is string && data.timestamp.size() <= 50
              && data.surveyTitle is string && data.surveyTitle.size() <= 150
              && data.type is string && data.type.size() <= 100
              && data.description is string && data.description.size() <= 500
              && data.severity is string && data.severity.size() <= 50;
        }
        
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidFraudLog(incoming());
      }
    }
  }
}
